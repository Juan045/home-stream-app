# Copiar a .env y ajustar.

# Directorio del host con los videos. Se monta read-only en /media.
# Windows: usar barras normales, ej. Z:/Videos
MEDIA_DIR=Z:/Videos

# Nombre del archivo dentro de MEDIA_DIR.
VIDEO=peli.mkv

# Puerto del host donde queda expuesto el player.
PORT=8000

# Tope del cache de artefactos en bytes (default: 50 GB). Al superarlo se
# borran los assets menos usados que nadie este mirando.
MAX_CACHE_SIZE=53687091200

# Log detallado (nivel DEBUG, salida legible). Valores: 1, true, yes.
DEBUG=0
