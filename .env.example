# Copiar a .env y ajustar MEDIA_DIR a la carpeta de videos del host.
# En Windows, usar barras normales, por ejemplo Z:/Videos.
MEDIA_DIR=Z:/Videos

# Puerto del host que publica la API.
PORT=8000

# Rutas dentro del contenedor .NET.
SM_MEDIA_ROOT=/media
SM_CACHE_DIR=/output
Database__Path=/data/media.sqlite

# Limite de procesos FFmpeg concurrentes.
SM_MAX_CONCURRENT_FFMPEG=2
